name: Merge checks
on:
  pull_request:
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
defaults:
  run:
    shell: bash
jobs:
  checks:
    runs-on: "{{RUNNER_LABEL}}"
    timeout-minutes: 30
    steps:
      - name: Check out source
        uses: "{{CHECKOUT_ACTION}}"
        with:
          persist-credentials: false
      - name: Run repository checks
        run: |
          {{CHECK_COMMAND}}
