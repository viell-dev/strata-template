# Release checks: runs the three stages of the release gate in RELEASING.md on demand, one job
# per stage. Keep the commands identical to RELEASING.md. Manual dispatch only: no push or pull
# request triggers.
name: Release checks
on:
  workflow_dispatch:
permissions:
  contents: read
defaults:
  run:
    shell: bash
jobs:
  fast:
    name: Fast checks
    runs-on: "{{RUNNER_LABEL}}"
    timeout-minutes: 30
    steps:
      - name: Check out source
        uses: "{{CHECKOUT_ACTION}}"
        with:
          persist-credentials: false
      - name: Install rustup
        run: |
          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
            | sh -s -- -y --profile minimal --default-toolchain none
          echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
      - name: Install the development compiler from rust-toolchain.toml
        run: |
          rustup toolchain install
          rustc --version
      - run: cargo fmt --check
      - run: cargo clippy --all-targets --all-features -- -D warnings
      - run: cargo test --all-targets --all-features
      - run: cargo test --doc --all-features
      - run: RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features

  msrv:
    name: Minimum supported Rust version
    runs-on: "{{RUNNER_LABEL}}"
    timeout-minutes: 30
    steps:
      - name: Check out source
        uses: "{{CHECKOUT_ACTION}}"
        with:
          persist-credentials: false
      - name: Install rustup
        run: |
          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
            | sh -s -- -y --profile minimal --default-toolchain none
          echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
      - name: Read rust-version with Cargo and install the minimum compiler
        run: |
          # Cargo from the development toolchain reads the manifest before the MSRV is installed.
          rustup toolchain install
          rustc --version
          msrv=$(cargo metadata --no-deps --format-version 1 | python3 -c '
          import json, pathlib, sys
          metadata = json.load(sys.stdin)
          packages = metadata["packages"]
          manifest = pathlib.Path("Cargo.toml").resolve()
          if len(packages) != 1 or pathlib.Path(packages[0]["manifest_path"]).resolve() != manifest:
              sys.exit("This adapter requires a standalone root Cargo package")
          package = packages[0]
          msrv = package.get("rust_version")
          if not msrv:
              sys.exit("No package.rust-version declared in Cargo.toml")
          print(msrv)
          ')
          rustup toolchain install "$msrv" --profile minimal
          rustc +"$msrv" --version
          echo "msrv=$msrv" >> "$GITHUB_ENV"
      - run: cargo +"$msrv" test --all-targets --all-features
      - run: cargo +"$msrv" test --doc --all-features

  package:
    name: Package
    runs-on: "{{RUNNER_LABEL}}"
    timeout-minutes: 30
    steps:
      - name: Check out source
        uses: "{{CHECKOUT_ACTION}}"
        with:
          persist-credentials: false
      - name: Install rustup
        run: |
          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
            | sh -s -- -y --profile minimal --default-toolchain none
          echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"
      - name: Install the development compiler from rust-toolchain.toml
        run: |
          rustup toolchain install
          rustc --version
      - run: cargo package --list
      - run: cargo package
      - name: Test the extracted package
        run: |
          package_dir=$(cargo metadata --no-deps --format-version 1 | python3 -c '
          import json, pathlib, sys
          metadata = json.load(sys.stdin)
          packages = metadata["packages"]
          manifest = pathlib.Path("Cargo.toml").resolve()
          if len(packages) != 1 or pathlib.Path(packages[0]["manifest_path"]).resolve() != manifest:
              sys.exit("This adapter requires a standalone root Cargo package")
          package = packages[0]
          if package["name"] != sys.argv[1]:
              sys.exit("PROJECT_NAME does not match the root Cargo package")
          print(pathlib.Path(metadata["target_directory"]) / "package" /
                "{}-{}".format(package["name"], package["version"]))
          ' "{{PROJECT_NAME}}")
          cd "$package_dir" || exit 1
          cargo test --all-targets --all-features
          cargo test --doc --all-features
